# Reference for every setting the app reads. Copy to .env for your own notes, but the
# application reads real environment variables, not this file (no python-dotenv
# dependency) — `export` what you need, or pass them through docker compose.
# Every value below is the built-in default from config.py.

# --- Data and index locations ---
MEME_DATA_DIR=data
MEME_IMAGE_DIR=data/images/images
MEME_TEXT_INDEX=data/text.index
MEME_IMAGE_INDEX=data/image.index
MEME_ID_MAP=data/id_map.json
MEME_METADATA=data/memes_final.jsonl

# --- MongoDB ---
MEME_MONGO_URI=mongodb://localhost:27017
MEME_MONGO_DB=meme_search
MEME_MONGO_COLLECTION=memes

# --- Model ---
MEME_CLIP_MODEL=ViT-B/32
# cpu, mps (Apple Silicon) or cuda
MEME_DEVICE=cpu

# --- Serving ---
MEME_API_HOST=0.0.0.0
MEME_API_PORT=8000
# Base URL used to build the image_url returned by the API.
MEME_PUBLIC_BASE_URL=http://127.0.0.1:8000
# Comma-separated. Tighten this before exposing the API anywhere.
MEME_CORS_ORIGINS=*
MEME_LOG_LEVEL=INFO

# --- Search behaviour ---
MEME_DEFAULT_TOP_K=5
MEME_MAX_TOP_K=50
# Weight for the OCR-text index when fusing hybrid results (0.0-1.0).
MEME_HYBRID_TEXT_WEIGHT=0.5
# Extra candidates pulled from each index before fusion.
MEME_HYBRID_OVERSAMPLE=4

# --- Clients ---
MEME_API_BASE_URL=http://127.0.0.1:8000

# --- Indexing scripts ---
MEME_BATCH_SIZE=32
