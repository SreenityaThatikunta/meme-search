{
  "manifest_version": 3,
  "name": "Meme Search",
  "description": "Semantic meme search powered by CLIP and FAISS, served by a local API.",
  "version": "1.1",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Meme Search"
  },
  "permissions": [],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ]
}
